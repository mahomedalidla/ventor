# Proyecto Supabase del sistema de ventas (NUEVO, separado de la app)
# Project URL: Settings → API (o la URL del proyecto)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# En el dashboard nuevo de Supabase se llaman así:
#   Publishable key  →  NEXT_PUBLIC_SUPABASE_ANON_KEY  (sí va al frontend)
#   Secret key       →  SUPABASE_SERVICE_ROLE_KEY       (NUNCA al frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key

# Solo servidor / Edge Functions — nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=your_secret_key

# Google Places API (New) — solo servidor
GOOGLE_PLACES_API_KEY=your_google_places_key

# Unsplash (opcional) — fotos de respaldo si el negocio no tiene fotos en Places
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Motor de inferencia — prioridad: Gemini → Claude → reglas del playbook
GEMINI_API_KEY=your_gemini_key
# Opcional (default: gemini-3.8-flash). El 2.5 ya no está abierto a proyectos nuevos.
# GEMINI_MODEL=gemini-3.8-flash
# Landings: el mismo, o gemini-3.5-flash si 3.8 no responde
# GEMINI_DEMO_MODEL=gemini-3.8-flash

# Correos que pueden entrar (separados por coma). Sin esto, cualquier usuario
# de Auth entra. Pon el tuyo y el de tu equipo, y desactiva el registro en
# Supabase → Authentication → Providers → Email → "Allow new users to sign up".
# ALLOWED_EMAILS=tu@correo.com,socio@correo.com

# Opcional — respaldo si Gemini falla o no está configurado
# ANTHROPIC_API_KEY=your_anthropic_key

# --- Reservado: monetización de app existente (fase posterior) ---
# APP_SUPABASE_URL=https://YOUR_APP_PROJECT.supabase.co
# APP_SUPABASE_READONLY_KEY=your_readonly_key
